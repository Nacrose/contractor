{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".test-build",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["gen/typescript/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"]
}
